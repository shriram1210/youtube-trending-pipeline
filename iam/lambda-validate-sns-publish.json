{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::yt-pipeline-silver-<yourname>",
        "arn:aws:s3:::yt-pipeline-silver-<yourname>/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:<account-id>:pipeline-alerts"
    }
  ]
}
